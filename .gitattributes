# Gaussian input sections require terminating blank records.
*.gjf whitespace=-blank-at-eof
# Preserve standard CSV record terminators in hashed scientific exports.
provenance/**/trajectory_metrics.csv whitespace=trailing-space,space-before-tab,cr-at-eol
# Preserve hashed Amber tool logs and force-field record terminators.
provenance/**/antechamber.stdout.log.txt whitespace=-blank-at-eof
provenance/**/gaff2_inventory.frcmod whitespace=-blank-at-eof
provenance/design_ranking_final_export_20261022/source_evidence/README.md.txt whitespace=-blank-at-eol
provenance/ti1_completed_results_export_20261023/references/*/final_structure.sdf whitespace=-blank-at-eol
provenance/ti1_results_followup_export_20261023/references/*/final_structure.sdf whitespace=-blank-at-eol
provenance/native_ti1_seed_20261023/**/native_seed.sdf whitespace=-blank-at-eol
provenance/native_ti1_seed_20261023/freeze_flags_preflight_01/optimization.log.txt whitespace=-blank-at-eol
provenance/truncated_ti1_pilot_20261023/**/native_seed.sdf whitespace=-blank-at-eol
provenance/waterfree_ti1_reference_20261023/**/*.sdf whitespace=-blank-at-eol
provenance/waterfree_ti1_reference_20261023/**/optimization.log.txt whitespace=-blank-at-eol
provenance/waterfree_ti1_trajectory_20261023/trajectory/optimization.log.txt whitespace=-blank-at-eol
provenance/waterfree_ti1_trajectory_20261023/trajectory/optimization_trajectory.pdb whitespace=-blank-at-eol
provenance/waterfree_ti1_trajectory_20261023/**/*.sdf whitespace=-blank-at-eol

# Fixed-column structural inputs retain padding and exact source hashes.
*.pdb -text whitespace=-blank-at-eol
# Standard CSV writers emit CRLF; retain the hashed export bytes unchanged.
*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
