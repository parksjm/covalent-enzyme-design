# Concatenated biased windows; not a continuous reaction trajectory.
set here [file dirname [file normalize [info script]]]; set title {NEB-US movie}
namespace eval ::neb_us_movie {variable molecule {}}
proc ::neb_us_movie::remove {molid} {
 foreach kind {Atoms Bonds Angles Dihedrals} {
  set labels [label list $kind]
  for {set i [expr {[llength $labels]-1}]} {$i >= 0} {incr i -1} {
   set owned 0
   foreach spec [lindex $labels $i] {if {[llength $spec] == 2 && [lindex $spec 0] eq $molid} {set owned 1}}
   if {$owned} {label delete $kind $i}
  }
 }
 mol delete $molid
}
set previous $::neb_us_movie::molecule
if {$previous ne {} && [lsearch -exact [molinfo list] $previous] >= 0} {::neb_us_movie::remove $previous}
set molid [mol new [file join $here path.parm7] type parm7 waitfor all]
mol rename $molid $title
mol addfile [file join $here path.dcd] type dcd waitfor all molid $molid
if {[molinfo $molid get numframes] != 1890} {error {Unexpected trajectory frame count}}
set ::neb_us_movie::molecule $molid
mol delrep 0 $molid
color Element H white; color Element N blue; color Element O red; label textsize 0.6
color change rgb 3 1.0 0.5 0.0
mol representation NewCartoon; mol color Structure; mol selection protein; mol addrep $molid; mol showrep $molid 0 off
mol representation Licorice 0.18 12 12; mol color Element; mol selection {index 1620 1621 1622 1623 1624 1625 1626 1627 1628 1629 1630 1631 1632 1633 1634 1635 1636 1637 1638 1639 1640 1641 1642 1643 1644 1645 1646 1647 1648 1649 1650 1651 1652 1653 1654 2726 2727 2728 2729 2730 2731 2732 2733 13904 13905 13906 13907 13908 13909 13910 13911 13912 13913 13914 13915 13916 13917 13918 13919 13920 13921 13922 13923 13924 13925 13926 13927 13928 13929 13930 14554 14555 14556 14557 14558 14559 14573 14574 14575 14576 14577 14578 19888 19889 19890 19891 19892 19893 19894 19895 19896 19897 19898 19899 19900 19901 19902 19903 19904 19905 19906 19907 19908 19909 19910 19911 19912 19913 19914 19915 19916 19917 19918 19919 19920 19921 19922 19923 19924 19925 19926 19927 19928 19929 19930 19931 19932 19933 19934 19935 19936 19937 19938 19939 19940 19941 19942 19943 19944 19945 19946 19947 19948 19949 19950 19951 19952 19953 19954 19955 19956 19957 19958 19959 19960 19961 19962 19963 19964 19965 19966}; mol addrep $molid
mol representation Licorice 0.25 12 12; mol color ColorID 3; mol selection {index 19889 19890 19891 19892 19893 19894 19910 19911 19912 19931 19932 19933 19934 19948 19949 19950 19951 19952 19953}; mol addrep $molid
set sel [atomselect $molid all]; set bonds [$sel getbonds]
foreach pair {{1637 1638} {2731 2732} {2731 2733} {13904 13905} {13904 13906} {13915 13916} {13919 13920} {13929 13930} {19915 19928} {19928 19936}} {
 set a [lindex $pair 0]; set b [lindex $pair 1]
 set row [lindex $bonds $a]; set pos [lsearch -exact $row $b]; if {$pos >= 0} {set row [lreplace $row $pos $pos]}; lset bonds $a $row
 set row [lindex $bonds $b]; set pos [lsearch -exact $row $a]; if {$pos >= 0} {set row [lreplace $row $pos $pos]}; lset bonds $b $row
}
$sel setbonds $bonds; $sel delete
foreach pair {{13915 19915} {19915 19928}} {mol representation DynamicBonds 1.85 0.1 12; mol color Element; mol selection [format {index %s %s} [lindex $pair 0] [lindex $pair 1]]; mol addrep $molid}
