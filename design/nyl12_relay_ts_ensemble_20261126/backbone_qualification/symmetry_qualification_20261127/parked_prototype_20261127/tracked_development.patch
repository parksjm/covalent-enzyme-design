+++ b/src/nyl12_covalent/rfd3_export_adapter.py
@@ -9,6 +9,45 @@ import numpy as np
 AtomKey = tuple[str, int, str]
 
 
+def export_center(
+    spec: dict[str, Any],
+    keys: list[AtomKey],
+    coords: np.ndarray,
+    mobile_residues: set[str],
+    symmetry_center_A: list[float] | None = None,
+) -> np.ndarray:
+    """Select a qualified native frame without guessing a symmetry transform.
+
+    Args:
+        spec: Actual native input specification.
+        keys: Source atom identities in coordinate order.
+        coords: Finite source coordinates.
+        mobile_residues: Explicit motion mask for default partial diffusion.
+        symmetry_center_A: Exact protein center retained by symmetry preflight.
+
+    Returns:
+        Float32 translation removed by the native input parser.
+
+    Raises:
+        ValueError: A frame override or missing/invalid symmetry pin is present.
+    """
+    if spec.get("ori_token") is not None or spec.get("infer_ori_strategy") is not None:
+        raise ValueError("Unqualified native frame override")
+    if spec.get("symmetry"):
+        if spec["symmetry"]["id"] != "D2" or symmetry_center_A is None:
+            raise ValueError("Symmetric export requires a preflight-pinned D2 center")
+        center = np.asarray(symmetry_center_A, dtype=np.float32)
+        if center.shape != (3,) or not np.isfinite(center).all():
+            raise ValueError("Invalid symmetry center")
+        return center
+    if symmetry_center_A is not None:
+        raise ValueError("Symmetry center supplied for an asymmetric input")
+    moving = np.array([f"{c}{p}" in mobile_residues for c, p, _ in keys])
+    if not moving.any():
+        raise ValueError("Empty native mobile mask")
+    return np.asarray(coords, dtype=np.float32)[moving].mean(axis=0)
+
+
