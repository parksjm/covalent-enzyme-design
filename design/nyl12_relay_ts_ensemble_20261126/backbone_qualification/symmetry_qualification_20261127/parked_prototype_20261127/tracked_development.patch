+def test_export_center_requires_explicit_symmetry_frame() -> None:
+    """Preserve default COM but require a retained center for symmetric native runs."""
+    keys, source, _, _, mobile, center = fixture()
+    np.testing.assert_array_equal(
+        export_center({}, keys, source, mobile), source.astype(np.float32)[-1]
+    )
+    symmetric = {"symmetry": {"id": "D2"}}
+    np.testing.assert_array_equal(
+        export_center(symmetric, keys, source, mobile, center.tolist()), center
+    )
+    for spec, mask, pin in (
+        ({"ori_token": "A1"}, mobile, None),
+        ({"infer_ori_strategy": "x"}, mobile, None),
+        (symmetric, mobile, None),
+        ({"symmetry": {"id": "C4"}}, mobile, center.tolist()),
+        (symmetric, mobile, [0, 1]),
+        (symmetric, mobile, [float("nan"), 0, 0]),
+        ({}, mobile, center.tolist()),
+        ({}, set(), None),
+    ):
+        with pytest.raises(ValueError):
+            export_center(spec, keys, source, mask, pin)
