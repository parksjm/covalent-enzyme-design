  "calculation_source": "\"\"\"Read-only source calculation; writes the requested diagnostic JSON only.\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\nimport numpy as np\nfrom nyl12_covalent.rfd3_symmetry_geometry import (\n    fit_d2_operators, reference_projection, displacement_metrics,\n    operator_closure_metrics,\n)\n\nROOT = Path('/data/jpc/covalent-enzyme-design')\nOUTPUT = ROOT / 'design/nyl12_relay_ts_ensemble_20261126/backbone_qualification/symmetry_qualification_20261127/exact_projection_rejection.json'\nmodule = ROOT / 'src/nyl12_covalent/rfd3_symmetry_geometry.py'\nrecords = []\nfor name in ('medoid_01_delivery_full_010_frame_068', 'medoid_03_delivery_full_007_frame_095'):\n    path = ROOT / 'design/nyl12_relay_ts_ensemble_20261126/templates' / name / 'complex_heavy.pdb'\n    chains = {chain: {} for chain in 'ABCDEFGH'}\n    for line in path.read_text().splitlines():\n        if line.startswith('ATOM') and line[21] in chains:\n            key = (int(line[22:26]), line[12:16].strip())\n            if key in chains[line[21]]:\n                raise ValueError('Duplicate source atom identity')\n            if line[16] not in (' ', 'A'):\n                raise ValueError('Unexpected alternate conformer')\n            chains[line[21]][key] = np.array([float(line[30:38]), float(line[38:46]), float(line[46:54])])\n    keys = [[(segment, residue, atom) for segment, chain in [('alpha', alpha), ('beta', beta)]\n             for residue, atom in chains[chain]] for alpha, beta in zip('ABCD', 'EFGH')]\n    xyz = np.array([[coord for chain in (alpha, beta) for coord in chains[chain].values()]\n                    for alpha, beta in zip('ABCD', 'EFGH')])\n    if any(repeat != keys[0] for repeat in keys[1:]):\n        raise ValueError('Source heavy atom correspondence differs')\n    backbone = np.array([key[2] in {'N', 'CA', 'C', 'O'} for key in keys[0]])\n    backbone_keys = [[key for key, selected in zip(repeat, backbone) if selected] for repeat in keys]\n    operators = fit_d2_operators(xyz[:, backbone], backbone_keys)\n    projected = reference_projection(xyz, operators)\n    distances = np.linalg.norm(projected - xyz, axis=-1)\n    top = np.argsort(distances.ravel())[-12:][::-1]\n    outliers = [{'repeat_index': int(i), 'atom_key': keys[i][j], 'displacement_A': float(distances[i, j])}\n                for i, j in [np.unravel_index(index, distances.shape) for index in top]]\n    result = {\n        'source': str(path.relative_to(ROOT)),\n        'source_sha256': hashlib.sha256(path.read_bytes()).hexdigest(),\n        'n_heavy_atoms_per_repeat': xyz.shape[1],\n        'n_backbone_atoms_per_repeat': int(backbone.sum()),\n        'atom_keys_sha256': hashlib.sha256(json.dumps(keys, separators=(',', ':')).encode()).hexdigest(),\n        'backbone_displacement': displacement_metrics(xyz[:, backbone], projected[:, backbone]),\n        'heavy_displacement': displacement_metrics(xyz, projected),\n        'per_repeat_backbone_displacement': [displacement_metrics(a, b) for a, b in zip(xyz[:, backbone], projected[:, backbone])],\n        'top_heavy_displacements': outliers,\n        'operator_closure': operator_closure_metrics(operators),\n        'center_A': operators.center.tolist(),\n        'row_rotations': operators.rotations.transpose(0, 2, 1).tolist(),\n        'translations_A': (operators.center - np.einsum('j,kji->ki', operators.center, operators.rotations.transpose(0, 2, 1))).tolist(),\n        'projected_protein_coordinates_float64_little_endian_sha256': hashlib.sha256(projected.astype('<f8').tobytes()).hexdigest(),\n    }\n    for label, coords in [('source', xyz), ('exact_projection', projected)]:\n        minimum, counts = float('inf'), {str(threshold): 0 for threshold in (1., 1.5, 2.)}\n        clashes = []\n        for i in range(4):\n            for j in range(i + 1, 4):\n                pair_distances = np.linalg.norm(coords[i, :, None, :] - coords[j, None, :, :], axis=-1)\n                minimum = min(minimum, float(pair_distances.min()))\n                for threshold in (1., 1.5, 2.):\n                    counts[str(threshold)] += int((pair_distances < threshold).sum())\n                for a, b in np.argwhere(pair_distances < 1.):\n                    clashes.append({'repeat_indices': [i, j], 'atom_keys': [keys[i][a], keys[j][b]],\n                                    'distance_A': float(pair_distances[a, b])})\n        result[label + '_interrepeat_heavy'] = {\n            'minimum_A': minimum, 'pair_counts_below_A': counts, 'pairs_below_1A': clashes,\n        }\n    records.append(result)\npayload = {\n    'schema_version': 1,\n    'status': 'rejected_exact_AE_coordinate_copy_initialization',\n    'reason': 'AE-generated exact copies introduce inter-repeat heavy-atom overlaps below 1 Angstrom in both source medoids; source asymmetry cannot be silently projected away.',\n    'scope': 'Read-only protein initialization feasibility diagnostic; no RFD3 job, no source coordinates changed, no TS atoms projected or duplicated.',\n    'coupled_repeat_order': [['A', 'E'], ['B', 'F'], ['C', 'G'], ['D', 'H']],\n    'operator_convention': 'row vectors: x_new = x @ row_rotation + translation_A; translation=center-center@row_rotation',\n    'fit_method': 'Joint alpha+beta N/CA/C/O atoms, source-AE pair Kabsch axes, polar orthogonalization to exact D2, centroid least-squares common center; projected copies generated from unchanged AE.',\n    'atom_mapping': 'Identical segment(alpha/beta), source canonical residue number, atom name in all four repeats; ATOM records only. No alignment or per-chain fitting in displacement metrics. OXT counted heavy but not backbone.',\n    'clash_definition': 'All heavy ATOM pairs across distinct coupled repeats, each unordered repeat pair once; intra-repeat alpha/beta pairs excluded.',\n    'threshold_policy': '1/1.5/2 Angstrom bins are diagnostic overlap counts, not newly approved campaign tolerances.',\n    'geometry_module': str(module.relative_to(ROOT)),\n    'geometry_module_sha256': hashlib.sha256(module.read_bytes()).hexdigest(),\n    'numpy_version': np.__version__,\n    'results': records,\n    'reproduction_command': 'PYTHONPATH=src uv run python /path/to/extracted_calculation.py',\n    'calculation_source': Path(__file__).read_text(),\n}\nOUTPUT.write_text(json.dumps(payload, indent=2, allow_nan=False) + '\\n')\n"
}
