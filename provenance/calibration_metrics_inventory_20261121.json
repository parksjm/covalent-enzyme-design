{
  "additional_md_metric_availability": {
    "current_wt_only_four_site_md": "The later WT four-site MD summary provides per-seed/site medians for d1/d2/d3, alpha-BD, absolute Herschlag phi, ligand RMSD, tier fractions, and second-half tier A/B. It contains 8 rows (2 seeds \u00d7 4 sites), WT only, and cannot be matched against mutant models. Campaign metadata states 100 ns, 200 compact frames per seed, stride 10, contact cutoff 4.0 \u00c5.",
    "historical_summary": "Historical MD summary contains variant-level Tier A/B/C occupancy, persistent replicate count, mean d1, activity, and family, but no model/replica-level geometry or per-gate flags.",
    "strain_metrics": "No directly comparable per-model strain-energy table found among the consolidated balanced outputs. interface_delta is Rosetta interface score, not ligand strain."
  },
  "inventory_date": "2026-11-21",
  "missingness_notes": "Target-level selected PA6 and PA66 model records are enumerated above with per-column nonfinite/missing counts. Historical MD table is variant-level aggregation; static directionality tables omit per-model diagnostics by design. Protonation identity and calibrated force-field validity remain unverified in this bounded inventory.",
  "primary_static_model_level_inputs": {
    "balanced_script": "The frozen analysis script selects PA6 rows by prefix and model indices 0\u201349 from pa6_model_metrics, and PA66 rows by a separate prefix and indices 0\u201349 from pa66_model_metrics. There is no individual-row CSV in the balanced output directory; these full_metrics tables are its exact model-level inputs.",
