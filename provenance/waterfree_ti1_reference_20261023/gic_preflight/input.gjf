%mem=256MB
%nprocshared=1
#p HF/STO-3G Opt=(ReadAllGIC,Tight,MaxCycles=40,MaxStep=2) SCF=Tight NoSymm

GIC freeze syntax test only; not TI1 data

0 1
O 0.0 0.0 0.0
O 1.4 0.0 0.0
H -0.4 0.9 0.0
H 1.8 0.5 0.8

