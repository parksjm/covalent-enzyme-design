CY1(Frozen)=Y(1)
CZ1(Frozen)=Z(1)
CX2(Frozen)=X(2)
CY2(Frozen)=Y(2)
CZ2(Frozen)=Z(2)
CX3(Frozen)=X(3)
CY3(Frozen)=Y(3)
CZ3(Frozen)=Z(3)
CX4=X(4)
CY4=Y(4)
CZ4=Z(4)
CHI(Frozen)=D(3,1,2,4)

